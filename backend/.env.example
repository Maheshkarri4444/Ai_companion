# Copy to `.env` and fill in real values. Never commit `.env`.
# Quote any value containing `#` (e.g. PASSWORD="abc#123"): unquoted, `#` starts a comment.

NODE_ENV=development
PORT=4000
# all = API + background worker in one process · api · worker
APP_ROLE=all

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
MONGODB_DB_NAME=ai_study_companion

# Sessions — generate a secret with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<at-least-32-random-characters>
SESSION_TTL_DAYS=7
COOKIE_NAME=asc_session
# true in production (HTTPS)
COOKIE_SECURE=false
BCRYPT_ROUNDS=12

# Only needed for direct (non-proxied) browser access
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=1
RATE_LIMIT_ENABLED=true
MAX_UPLOAD_MB=20

# Admin account created on first boot (reset with `npm run seed:admin`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<strong-password>
ADMIN_NAME=Platform Admin

# Google Gemini (used from Phase 2/3)
GEMINI_API_KEY=<your-gemini-api-key>
AI_MODEL_PRIMARY=gemini-3.7-flash
AI_MODEL_FALLBACKS=gemini-3.6-flash,gemini-3.5-flash-lite
AI_MODEL_LIGHT=gemini-3.5-flash-lite
AI_EMBEDDING_MODEL=gemini-embedding-2
AI_EMBEDDING_DIM=768

LOG_LEVEL=info
